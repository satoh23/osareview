{
  "name": "@comment-dock/auth",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "comment-dock-auth": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "login": "tsx src/cli.ts login",
    "logout": "tsx src/cli.ts logout",
    "auth:cli": "tsx src/cli.ts",
    "check-types": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@comment-dock/shared": "workspace:*",
    "@napi-rs/keyring": "^1.2.0",
    "dotenv": "^17.4.2",
    "open": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.3",
    "tsx": "^4.21.0",
    "typescript": "~5.8.3"
  }
}
