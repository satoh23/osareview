{
  "name": "@comment-dock/api-gateway",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @comment-dock/auth build && pnpm --filter @comment-dock/comment-fetcher build && pnpm --filter @comment-dock/comment-delivery build && tsx watch src/index.ts",
    "dev:inject": "tsx scripts/inject-test-comments.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "check-types": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@comment-dock/auth": "workspace:*",
    "@comment-dock/comment-delivery": "workspace:*",
    "@comment-dock/comment-fetcher": "workspace:*",
    "@comment-dock/shared": "workspace:*",
    "@hono/node-server": "^2.0.2",
    "dotenv": "^17.4.2",
    "hono": "^4.12.18",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.3",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.3"
  }
}
