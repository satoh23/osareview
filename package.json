{
  "name": "comment-dock",
  "private": true,
  "scripts": {
    "dev": "pnpm run --parallel dev:desktop-tauri dev:comment-delivery",
    "dev:comment-fetcher": "pnpm --filter @comment-dock/comment-fetcher dev",
    "dev:comment-delivery": "pnpm --filter @comment-dock/comment-delivery dev",
    "dev:comment-delivery-mock-ws": "pnpm --filter @comment-dock/comment-delivery dev:mock-ws",
    "dev:desktop-tauri": "pnpm --filter @comment-dock/desktop tauri dev",
    "dev:desktop": "pnpm --filter @comment-dock/desktop dev",
    "build": "pnpm -r --if-present run build",
    "preview": "pnpm -r --if-present run preview",
    "tauri": "pnpm -r --if-present run tauri",
    "check-types": "pnpm -r --if-present run check-types",
    "lint": "eslint .",
    "format": "pnpm exec prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.58.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
