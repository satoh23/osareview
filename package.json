{
  "name": "comment-dock",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @comment-dock/desktop dev",
    "build": "pnpm --filter @comment-dock/desktop build",
    "preview": "pnpm --filter @comment-dock/desktop preview",
    "tauri": "pnpm --filter @comment-dock/desktop tauri",
    "format": "pnpm exec prettier --write .",
    "prepare": "husky install"
  },
  "devDependencies": {
    "husky": "^8.0.0",
    "prettier": "^3.8.1"
  }
}
